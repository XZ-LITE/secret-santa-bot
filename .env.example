# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789,987654321

# Начальный список разрешенных пользователей (whitelist) через запятую
INITIAL_ALLOWED_USERS=123456789,987654321,112233445

# Бюджет подарка в рублях
GIFT_BUDGET=1000

# Пути к файлам базы данных и бэкапов
DB_PATH=data/database.json
BACKUP_DIR=backups

# Часовой пояс сервера (например, Europe/Moscow, UTC)
TZ=Europe/Moscow
